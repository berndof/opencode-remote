# OpenCode Remote Configuration Template
# Save as ~/.config/opencode/remote/<hostname>.env
# Ensure strict permissions: chmod 600 ~/.config/opencode/remote/<hostname>.env

# SSH Host alias (from ~/.ssh/config) or user@hostname
SSH_HOST=my-remote-server

# Local port to forward traffic through (defaults to 4096; auto-increments on collision)
LOCAL_PORT=4096

# Port where OpenCode service runs on the remote machine (defaults to 4096)
REMOTE_PORT=4096

# Absolute path to the OpenCode binary on the remote server (optional, auto-detected if omitted)
# REMOTE_OPENCODE=/home/username/.opencode/bin/opencode

# Default directory opened when launching OpenCode TUI without --dir (defaults to remote $HOME)
REMOTE_DIRECTORY=/home/username

# Authentication password for the remote OpenCode background service (auto-detected from ~/.opencode-serve.log if omitted)
OPENCODE_PASSWORD=your_service_password_here

# Close local SSH tunnel automatically when the OpenCode session exits (default: true)
CLOSE_TUNNEL_ON_EXIT=true

# Optional custom SSHFS mount options (comma-separated; overrides Low-Resource Guard defaults)
# SSHFS_OPTS=reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,follow_symlinks,compression=no
