# OpenCode Remote Configuration Template
# Save as ~/.config/opencode/remote/<hostname>.env
# Ensure strict permissions: chmod 600 ~/.config/opencode/remote/<hostname>.env

# SSH Host alias (from ~/.ssh/config) or user@hostname
SSH_HOST=my-remote-server

# Local port to forward traffic through (defaults to 7096)
# If connecting to multiple servers simultaneously, use different local ports (e.g. 7097, 7098)
LOCAL_PORT=7096

# Port where OpenCode service runs on the remote machine (defaults to 7096)
REMOTE_PORT=7096

# Absolute path to the OpenCode binary on the remote server
# (Required because non-interactive SSH sessions do not load full interactive ~/.bashrc / ~/.zshrc PATHs)
REMOTE_OPENCODE=/home/username/.opencode/bin/opencode

# Default directory opened when launching OpenCode TUI without directory arguments
REMOTE_DIRECTORY=/home/username

# Authentication password for the remote OpenCode background service
# Found on the remote host via: opencode service get password
# Or set via: opencode service set password <secret>
OPENCODE_PASSWORD=your_service_password_here
