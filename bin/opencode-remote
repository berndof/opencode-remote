#!/usr/bin/env python3
"""
opencode-remote: Remote host management & automation CLI tool for OpenCode.
"""

import sys
import os
import re
import getpass
import shutil
import argparse
import subprocess
import json
import time
import socket
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor, as_completed

STATE_DIR = Path.home() / ".opencode-remote"
TUNNELS_DIR = STATE_DIR / "tunnels"
CTL_DIR = STATE_DIR / "ctl"
MOUNTS_STATE_FILE = STATE_DIR / "mounts.json"
MOUNT_BASE = Path.home() / ".cache" / "opencode-remote" / "mounts"
LEGACY_MOUNT_BASE = Path.home() / ".cache" / "oc-remote" / "mounts"
CONFIG_DIR = Path.home() / ".config" / "opencode" / "remote"

# In-memory SSH passwords only (never written to disk).
_HOST_PASSWORDS = {}

# Color constants
USE_COLORS = sys.stdout.isatty()
GREEN = "\033[92m" if USE_COLORS else ""
RED = "\033[91m" if USE_COLORS else ""
YELLOW = "\033[93m" if USE_COLORS else ""
BLUE = "\033[94m" if USE_COLORS else ""
BOLD = "\033[1m" if USE_COLORS else ""
RESET = "\033[0m" if USE_COLORS else ""


def set_process_title(title=None):
    """Set process comm name (via prctl) and terminal window/tab title (OSC sequences)."""
    prog_name = "opencode-remote"
    if sys.argv and sys.argv[0]:
        base = os.path.basename(sys.argv[0])
        if base:
            prog_name = base

    chosen_title = title or prog_name

    # 1. Update Linux process name (/proc/self/comm) via prctl PR_SET_NAME
    if sys.platform.startswith("linux"):
        try:
            import ctypes
            libc = ctypes.CDLL(None)
            PR_SET_NAME = 15
            # PR_SET_NAME accepts max 16 bytes (15 chars + null byte)
            comm_str = chosen_title.split()[0] if " " in chosen_title else chosen_title
            name_bytes = comm_str[:15].encode("utf-8")
            libc.prctl(PR_SET_NAME, ctypes.c_char_p(name_bytes), 0, 0, 0)
        except Exception:
            pass

    # 2. Try setproctitle if available in the environment
    try:
        import setproctitle
        setproctitle.setproctitle(chosen_title)
    except Exception:
        pass

    # 3. Set terminal window and tab title via ANSI OSC 0 and OSC 2 escape sequences
    if sys.stdout.isatty():
        try:
            sys.stdout.write(f"\033]0;{chosen_title}\007\033]2;{chosen_title}\007")
            sys.stdout.flush()
        except Exception:
            pass


def parse_ssh_config(config_path=None):
    if config_path is None:
        config_path = Path.home() / ".ssh" / "config"

    if not config_path.exists():
        return []

    hosts = []
    current_host = None

    with open(config_path, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue

            parts = line.split(None, 1)
            if len(parts) < 2:
                continue

            key = parts[0].lower()
            val = parts[1].strip()

            if key == "host":
                host_names = val.split()
                for hn in host_names:
                    if "*" in hn or "?" in hn:
                        current_host = None
                        continue
                    current_host = {
                        "host": hn,
                        "hostname": hn,
                        "user": "-",
                        "port": "22"
                    }
                    hosts.append(current_host)
            elif current_host is not None:
                if key == "hostname":
                    current_host["hostname"] = val
                elif key == "user":
                    current_host["user"] = val
                elif key == "port":
                    current_host["port"] = val

    seen = set()
    unique_hosts = []
    for h in hosts:
        if h["host"] not in seen:
            seen.add(h["host"])
            unique_hosts.append(h)

    return unique_hosts


def load_host_config(host):
    """Load configuration from ~/.config/opencode/remote/<host>.env if available."""
    cfg = {
        "ssh_host": host,
        "local_port": 4096,
        "remote_port": 4096,
        "remote_opencode": None,
        "remote_directory": None,
        "opencode_password": None,
        "close_tunnel_on_exit": True,  # default: close tunnel when the session ends
    }
    env_file = CONFIG_DIR / f"{host}.env"
    if not env_file.exists():
        return cfg

    try:
        with open(env_file, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k = k.strip()
                v = v.strip().strip('"').strip("'")
                if k == "SSH_HOST":
                    cfg["ssh_host"] = v
                elif k == "LOCAL_PORT":
                    try:
                        cfg["local_port"] = int(v)
                    except ValueError:
                        pass
                elif k == "REMOTE_PORT":
                    try:
                        cfg["remote_port"] = int(v)
                    except ValueError:
                        pass
                elif k == "REMOTE_OPENCODE":
                    cfg["remote_opencode"] = v
                elif k == "REMOTE_DIRECTORY":
                    cfg["remote_directory"] = v
                elif k in ("OPENCODE_PASSWORD", "OPENCODE_SERVER_PASSWORD"):
                    cfg["opencode_password"] = v
                elif k in ("CLOSE_TUNNEL_ON_EXIT", "AUTO_CLOSE_TUNNEL"):
                    cfg["close_tunnel_on_exit"] = v.lower() in ("true", "1", "yes")
    except Exception:
        pass
    return cfg


def check_ssh_host_detailed(host, timeout=3, interactive=False):
    cmd = [
        "ssh",
        "-o", "BatchMode=yes",
        "-o", f"ConnectTimeout={timeout}",
        "-o", "StrictHostKeyChecking=accept-new",
        host,
        "true"
    ]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout + 2)
        if res.returncode == 0:
            return True, "ONLINE"
        err = ((res.stderr or "") + (res.stdout or "")).lower()
        if "permission denied" in err:
            # No usable key: optionally prompt for the password (TTY only),
            # validate it and cache the connection via ControlMaster.
            if interactive and sys.stdin.isatty() and prompt_ssh_password(host):
                try:
                    res2 = subprocess.run(
                        ["ssh"] + ssh_opts(host, ctl=True, batch=False) + [host, "true"],
                        capture_output=True, text=True, timeout=timeout + 10,
                        env=ssh_env(_HOST_PASSWORDS.get(host)),
                    )
                    if res2.returncode == 0:
                        return True, "ONLINE_PASSWORD"
                except Exception:
                    pass
                return False, "AUTH_FAILED"
            return False, "KEY_NEEDED"
        elif "timed out" in err or "timeout" in err:
            return False, "TIMEOUT"
        elif "could not resolve" in err or "name resolution" in err:
            return False, "DNS_FAILED"
        elif "connection refused" in err:
            return False, "CONN_REFUSED"
        elif "no route" in err:
            return False, "NO_ROUTE"
        return False, "OFFLINE"
    except subprocess.TimeoutExpired:
        return False, "TIMEOUT"
    except Exception:
        return False, "OFFLINE"


def check_ssh_host(host, timeout=3):
    ok, _ = check_ssh_host_detailed(host, timeout)
    return ok


# ---------------------------------------------------------------------------
# SSH transport: askpass (password prompt without sshpass) + ControlMaster
# (authenticates once per host, reuses the connection for every later command)
# ---------------------------------------------------------------------------

ASKPASS_FILE = STATE_DIR / "askpass.sh"


def _ensure_askpass():
    """Write a tiny askpass helper. It echoes $OC_SSH_PASSWORD (memory only)."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    body = '#!/bin/sh\nprintf "%s" "$OC_SSH_PASSWORD"\n'
    try:
        if not ASKPASS_FILE.exists() or ASKPASS_FILE.read_text() != body:
            ASKPASS_FILE.write_text(body)
            ASKPASS_FILE.chmod(0o700)
    except Exception:
        return None
    return str(ASKPASS_FILE)


def _ctl_socket(host):
    safe = "".join(c if (c.isalnum() or c in "._-") else "_" for c in host)
    return str(CTL_DIR / safe)


def ssh_env(password=None):
    env = os.environ.copy()
    if password:
        ap = _ensure_askpass()
        if ap:
            env["SSH_ASKPASS"] = ap
            env["SSH_ASKPASS_REQUIRE"] = "force"
            env["OC_SSH_PASSWORD"] = password
    return env


def ssh_opts(host, ctl=True, batch=False):
    opts = ["-o", "StrictHostKeyChecking=accept-new", "-o", "ConnectTimeout=5"]
    if ctl:
        try:
            CTL_DIR.mkdir(parents=True, exist_ok=True)
            opts += [
                "-o", f"ControlPath={_ctl_socket(host)}",
                "-o", "ControlMaster=auto",
                "-o", "ControlPersist=10m",
            ]
        except Exception:
            pass
    if batch:
        opts += ["-o", "BatchMode=yes"]
    return opts


def ssh_run(host, remote_cmd, *, ctl=True, capture=True, timeout=15, interactive=True):
    """Run a remote command. Falls back to an interactive password prompt when
    key auth is refused (only if stdin is a TTY). Returns CompletedProcess."""
    pw = _HOST_PASSWORDS.get(host)
    cmd = ["ssh"] + ssh_opts(host, ctl=ctl, batch=not pw) + [host, remote_cmd]
    try:
        res = subprocess.run(cmd, capture_output=capture, text=True,
                             timeout=timeout, env=ssh_env(pw))
    except subprocess.TimeoutExpired:
        raise
    if res.returncode != 0 and not pw and interactive and sys.stdin.isatty():
        err = ((res.stderr or "") + (res.stdout or "")).lower()
        if "permission denied" in err or "publickey" in err:
            if prompt_ssh_password(host):
                return ssh_run(host, remote_cmd, ctl=ctl, capture=capture,
                               timeout=timeout, interactive=False)
    return res


def prompt_ssh_password(host):
    """Ask the user for the SSH password once, validate it, keep it in memory."""
    if host in _HOST_PASSWORDS:
        return True
    if not sys.stdin.isatty():
        return False
    print(f"\n{YELLOW}Host '{host}' recusou a chave SSH (sem chave instalada).{RESET}")
    try:
        pw = getpass.getpass(f"Senha SSH para {host}: ")
    except (KeyboardInterrupt, EOFError):
        print()
        return False
    if not pw:
        return False
    _HOST_PASSWORDS[host] = pw
    try:
        res = subprocess.run(
            ["ssh"] + ssh_opts(host, ctl=True, batch=False) + [host, "true"],
            capture_output=True, text=True, timeout=15, env=ssh_env(pw),
        )
    except Exception:
        res = None
    if res is not None and res.returncode == 0:
        print(f"{GREEN}Autenticado por senha (guardada só em memória).{RESET}")
        print(f"  Dica: elimine o prompt para sempre -> {BOLD}opencode-remote copy-key {host}{RESET}\n")
        return True
    _HOST_PASSWORDS.pop(host, None)
    print(f"{RED}Senha rejeitada por '{host}'.{RESET}\n", file=sys.stderr)
    return False


def close_ssh_master(host):
    """Close a cached ControlMaster connection (called with stop/close)."""
    try:
        sock = _ctl_socket(host)
        if os.path.exists(sock):
            subprocess.run(["ssh", "-o", f"ControlPath={sock}", "-O", "exit", host],
                           capture_output=True, timeout=10)
    except Exception:
        pass


def is_process_running(pid):
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def get_ssh_tunnel_pid(host, port):
    try:
        res = subprocess.run(
            ["lsof", "-ti", f":{port}"],
            capture_output=True,
            text=True
        )
        if res.returncode == 0 and res.stdout.strip():
            pids = res.stdout.strip().split()
            for p in pids:
                try:
                    pid_int = int(p)
                    p_info = subprocess.run(["ps", "-p", str(pid_int), "-o", "comm="], capture_output=True, text=True)
                    if "ssh" in p_info.stdout.lower():
                        return pid_int
                except Exception:
                    pass
            return int(pids[0])
    except Exception:
        pass

    try:
        res = subprocess.run(
            ["pgrep", "-f", f"ssh.*-L.*{port}:127.0.0.1:.*{host}"],
            capture_output=True,
            text=True
        )
        if res.returncode == 0 and res.stdout.strip():
            pids = res.stdout.strip().split()
            return int(pids[0])
    except Exception:
        pass
    return None


def is_local_port_in_use(port, host="127.0.0.1"):
    """Check if a local TCP port is in use."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind((host, int(port)))
            return False
        except OSError:
            return True


def find_available_local_port(start_port=4096, max_attempts=100, host="127.0.0.1"):
    """Find the next available local port starting from start_port."""
    for p in range(start_port, start_port + max_attempts):
        if not is_local_port_in_use(p, host):
            return p
    raise RuntimeError(f"No available local port found in range {start_port}..{start_port + max_attempts - 1}")


def resolve_local_port(host, requested_port=None, default_port=4096, remote_port=4096):
    """
    Determine the local port to use for the SSH tunnel.
    If a healthy tunnel already exists for this host, reuse its local port.
    If requested_port is provided explicitly and in use, warn.
    If requested_port is None and default_port is in use by another session/process,
    auto-allocate the next free port and warn.
    Returns: (local_port, is_auto_allocated)
    """
    tunnel_file = TUNNELS_DIR / f"{host}.json"
    if tunnel_file.exists():
        try:
            data = json.loads(tunnel_file.read_text())
            saved_pid = data.get("pid")
            saved_local_port = data.get("local_port", data.get("port"))
            if saved_local_port and saved_pid and is_process_running(saved_pid):
                ok, _ = probe_http(saved_local_port, timeout=1)
                if ok:
                    return saved_local_port, False
        except Exception:
            pass

    if requested_port is not None:
        if is_local_port_in_use(requested_port):
            print(f"{YELLOW}⚠️  [Warning] Porta local {requested_port} já está em uso por outro processo ou túnel.{RESET}", file=sys.stderr)
        return requested_port, False

    if not is_local_port_in_use(default_port):
        return default_port, False

    allocated_port = find_available_local_port(start_port=default_port + 1)
    print(f"\n{YELLOW}⚠️  [Warning] Porta local {default_port} em uso por outra sessão/processo.{RESET}")
    print(f"{YELLOW}   Alocando automaticamente a porta livre {allocated_port} para o túnel local de '{host}' (localhost:{allocated_port} -> {host}:{remote_port}).{RESET}\n")
    return allocated_port, True


def stop_tunnel_only(host, port=None):
    tunnel_file = TUNNELS_DIR / f"{host}.json"
    target_port = port
    if tunnel_file.exists():
        try:
            data = json.loads(tunnel_file.read_text())
            pid = data.get("pid")
            if not target_port:
                target_port = data.get("local_port", data.get("port"))
            if pid and is_process_running(pid):
                try:
                    os.kill(pid, 15)
                except OSError:
                    pass
            tunnel_file.unlink(missing_ok=True)
        except Exception:
            pass

    if target_port:
        pid = get_ssh_tunnel_pid(host, target_port)
        if pid and is_process_running(pid):
            try:
                os.kill(pid, 15)
            except OSError:
                pass


def remote_port_listening_cmd(port):
    """Remote shell snippet: succeeds only if something LISTENS on 127.0.0.1:<port>."""
    return f"ss -tln 2>/dev/null | grep -qE ':{port}[[:space:]]'"


def remote_http_probe_cmd(port):
    """Remote shell snippet: real HTTP health probe (detects hung daemons that only accept TCP)."""
    url = f"http://127.0.0.1:{port}/"
    py = (
        'python3 -c "import urllib.request as u\n'
        'try:\n'
        f"    u.urlopen('{url}', timeout=3); print('ALIVE')\n"
        'except Exception as e:\n'
        '    print(type(e).__name__)\n'
        '    raise SystemExit\n"'
    )
    return (
        'if command -v curl >/dev/null 2>&1; then '
        f'c=$(curl -s -o /dev/null -m 4 -w "%{{http_code}}" "{url}" 2>/dev/null || true); '
        'case "$c" in [0-9][0-9][0-9]) echo "ALIVE";; *) echo "HTTP_FAIL:$c";; esac; '
        'elif command -v python3 >/dev/null 2>&1; then '
        f'{py}; '
        'else echo "UNKNOWN"; fi'
    )


def remote_service_healthy(host, port, timeout=20):
    """True = daemon answers HTTP, False = port open but hung / nothing there, None = unknown."""
    try:
        res = ssh_run(host, remote_http_probe_cmd(port), timeout=timeout, interactive=False)
    except Exception:
        return None
    out = (res.stdout or "").strip()
    if not res.returncode == 0 and not out:
        return False
    if "ALIVE" in out:
        return True
    if "UNKNOWN" in out:
        return None
    return False


def kill_remote_serve(host, port):
    """Terminate a stale/hung 'opencode serve' bound to <port> on the remote host."""
    kill_cmd = (
        f'PIDS=$(ss -tlnpH 2>/dev/null | grep -E ":{port}[[:space:]]" '
        f'| grep -oE "pid=[0-9]+" | cut -d= -f2 | sort -u); '
        f'if [ -n "$PIDS" ]; then kill $PIDS 2>/dev/null; sleep 1; '
        f'for p in $PIDS; do kill -9 "$p" 2>/dev/null; done; '
        f'echo "KILLED:$PIDS"; else echo "NONE"; fi'
    )
    try:
        res = ssh_run(host, kill_cmd, timeout=20)
        return "KILLED" in (res.stdout or "")
    except Exception:
        return False


def resolve_remote_opencode_bin():
    """Remote shell snippet that echoes the absolute path of the opencode binary."""
    return (
        'OC_BIN="$(command -v opencode 2>/dev/null || true)"; '
        'for c in "$HOME/.opencode/bin/opencode" "$HOME/.local/bin/opencode"; do '
        '[ -z "$OC_BIN" ] && [ -x "$c" ] && OC_BIN="$c"; done; '
        'printf "%s" "$OC_BIN"'
    )


def clean_password_token(pwd):
    """Extract clean password token, stripping any 'server password' or 'password:' prefix."""
    if not pwd:
        return None
    pwd = str(pwd).strip()
    m = re.search(r'(?:server password|password)[:\s]+([^\s\(\)\]\"\']+)', pwd, re.IGNORECASE)
    if m:
        return m.group(1).strip()
    tokens = pwd.split()
    if tokens:
        return tokens[-1].strip(" '\"()")
    return pwd


def get_remote_default_dir(host):
    """Retrieve remote user's home/working directory via SSH or cache."""
    tunnel_file = TUNNELS_DIR / f"{host}.json"
    if tunnel_file.exists():
        try:
            data = json.loads(tunnel_file.read_text())
            if data.get("remote_home"):
                return data["remote_home"]
        except Exception:
            pass

    try:
        res = ssh_run(host, 'printf "%s" "$HOME"', timeout=6, interactive=False)
        out = (res.stdout or "").strip()
        if out:
            return out
    except Exception:
        pass
    return "~"


def get_remote_server_password(host, cfg=None):
    """Retrieve password from remote log, host config, or saved tunnel metadata."""
    # 1. Try querying remote log for live server password first (most accurate)
    remote_cmd = 'cat "$HOME/.opencode-serve.log" 2>/dev/null | grep -E "(server password|password)" | tail -5'
    try:
        res = ssh_run(host, remote_cmd, timeout=6, interactive=False)
        out = (res.stdout or "").strip()
        if out:
            for line in reversed(out.splitlines()):
                token = clean_password_token(line)
                if token:
                    return token
    except Exception:
        pass

    # 2. Host config .env
    if cfg and cfg.get("opencode_password"):
        return clean_password_token(cfg["opencode_password"])

    # 3. Saved tunnel metadata
    tunnel_file = TUNNELS_DIR / f"{host}.json"
    if tunnel_file.exists():
        try:
            data = json.loads(tunnel_file.read_text())
            if data.get("password"):
                return clean_password_token(data["password"])
        except Exception:
            pass

    return None


def probe_http(port, timeout=5):
    """End-to-end probe of the tunnel: any HTTP status means the path is alive."""
    import urllib.request
    import urllib.error
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/", timeout=timeout) as r:
            return True, f"HTTP {r.status}"
    except urllib.error.HTTPError as e:
        # Server answered with 4xx/5xx -> tunnel + remote service are reachable.
        return True, f"HTTP {e.code}"
    except Exception as e:
        return False, type(e).__name__


def cmd_list(args):
    hosts = parse_ssh_config()
    if not hosts:
        print("No SSH hosts found in ~/.ssh/config.")
        return

    print(f"Checking connectivity for {len(hosts)} host(s)...")

    results = []
    with ThreadPoolExecutor(max_workers=min(10, len(hosts))) as executor:
        future_to_host = {
            executor.submit(check_ssh_host_detailed, h["host"], args.timeout): h for h in hosts
        }
        for future in as_completed(future_to_host):
            h = future_to_host[future]
            try:
                online, reason = future.result()
            except Exception:
                online, reason = False, "OFFLINE"
            h_copy = dict(h)
            h_copy["online"] = online
            h_copy["status"] = reason
            results.append(h_copy)

    # Sort results by original order
    host_order = {h["host"]: i for i, h in enumerate(hosts)}
    results.sort(key=lambda x: host_order.get(x["host"], 0))

    if args.json:
        print(json.dumps(results, indent=2))
        return

    # Table output
    fmt = "{:<22} {:<24} {:<16} {:<6} {:<15}"
    print("\n" + BOLD + fmt.format("HOST", "HOSTNAME", "USER", "PORT", "STATUS") + RESET)
    print("-" * 87)
    has_key_needed = False
    for r in results:
        status_code = r["status"]
        if status_code == "ONLINE":
            status_str = f"{GREEN}ONLINE{RESET}"
        elif status_code == "KEY_NEEDED":
            status_str = f"{YELLOW}KEY NEEDED{RESET}"
            has_key_needed = True
        elif status_code == "TIMEOUT":
            status_str = f"{RED}TIMEOUT{RESET}"
        elif status_code == "DNS_FAILED":
            status_str = f"{RED}DNS FAIL{RESET}"
        else:
            status_str = f"{RED}OFFLINE{RESET}"

        print(fmt.format(
            r["host"][:21],
            r["hostname"][:23],
            r["user"][:15],
            r["port"],
            status_str
        ))
    print()
    if has_key_needed:
        print(f"{YELLOW}💡 Dica:{RESET} Para hosts com '{YELLOW}KEY NEEDED{RESET}', configure a chave SSH pública com: {BOLD}ssh-copy-id <host>{RESET}\n")


def cmd_exec(args):
    cmd = ["ssh", args.host] + args.cmd
    res = subprocess.run(cmd)
    sys.exit(res.returncode)


def cmd_sync(args):
    local_path = os.path.abspath(args.local_dir)
    if not os.path.exists(local_path):
        print(f"{RED}Error:{RESET} Local directory '{local_path}' does not exist.", file=sys.stderr)
        sys.exit(1)

    if os.path.isdir(local_path) and not local_path.endswith("/"):
        local_path += "/"

    remote_target = f"{args.host}:{args.remote_dir}"
    rsync_cmd = ["rsync", "-avz", "--exclude", ".git", "--exclude", "node_modules"]
    if args.delete:
        rsync_cmd.append("--delete")
    if args.dry_run:
        rsync_cmd.append("--dry-run")
    rsync_cmd.extend([local_path, remote_target])

    print(f"{BLUE}Syncing:{RESET} {local_path} -> {remote_target}")
    print(f"Executing: {' '.join(rsync_cmd)}")
    res = subprocess.run(rsync_cmd)
    sys.exit(res.returncode)


def sync_opencode_environment(host):
    """Sync local OpenCode plugins, skills, and configuration to remote host."""
    local_cfg = Path.home() / ".config" / "opencode"
    if not local_cfg.exists():
        return

    print(f"{BLUE}Syncing OpenCode environment (plugins, skills, configs) to '{host}'...{RESET}")
    ssh_run(host, "mkdir -p ~/.config/opencode ~/.opencode/skills ~/.config/opencode/plugins", timeout=15)

    if shutil.which("rsync") is not None:
        items_to_sync = ["plugins", "skills", "agents", "package.json", "opencode.json"]
        for item in items_to_sync:
            src_path = local_cfg / item
            if src_path.exists():
                remote_target = f"{host}:~/.config/opencode/"
                rsync_cmd = [
                    "rsync", "-avz",
                    "--exclude", "node_modules",
                    "--exclude", ".git",
                    "--exclude", "*.bak*",
                    str(src_path),
                    remote_target
                ]
                subprocess.run(rsync_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"{GREEN}OpenCode environment synced to '{host}:~/.config/opencode/'.{RESET}")
    else:
        print(f"{YELLOW}rsync not found locally; skipping automatic environment sync.{RESET}")


def provision_remote_host(host, sync_config=True):
    """Install OpenCode headless on remote host and optionally sync environment."""
    print(f"{BLUE}Provisioning OpenCode on remote host '{host}'...{RESET}")
    install_script = (
        "command -v opencode >/dev/null 2>&1 && "
        "echo 'OpenCode is already installed: '$(opencode --version 2>/dev/null || echo 'headless') "
        "|| (curl -fsSL https://opencode.ai/install.sh | bash || curl -fsSL https://raw.githubusercontent.com/sst/opencode/main/install.sh | bash)"
    )
    cmd = ["ssh"] + ssh_opts(host, ctl=False) + [host, install_script]
    try:
        res = subprocess.run(cmd)
        if res.returncode != 0:
            print(f"{RED}Provisioning failed with exit code {res.returncode}.{RESET}", file=sys.stderr)
            return False
    except Exception as e:
        print(f"{RED}Provisioning failed: {e}{RESET}", file=sys.stderr)
        return False

    print(f"{GREEN}Provisioning completed successfully on '{host}'.{RESET}")
    if sync_config:
        sync_opencode_environment(host)
    return True


def cmd_provision(args):
    sync_cfg = not getattr(args, "no_sync", False)
    ok = provision_remote_host(args.host, sync_config=sync_cfg)
    sys.exit(0 if ok else 1)


def load_mounts_state():
    if MOUNTS_STATE_FILE.exists():
        try:
            return json.loads(MOUNTS_STATE_FILE.read_text())
        except Exception:
            pass
    return []


def save_mounts_state(mounts):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    MOUNTS_STATE_FILE.write_text(json.dumps(mounts, indent=2))


def is_sshfs_installed():
    return bool(shutil.which("sshfs"))



def get_active_sshfs_mounts():
    try:
        res = subprocess.run(["mount"], capture_output=True, text=True)
        if res.returncode == 0:
            lines = res.stdout.splitlines()
            return [line for line in lines if "sshfs" in line or "fuse.sshfs" in line]
    except Exception:
        pass
    return []


def mount_sshfs_target(host, remote_dir=None, local_name=None, custom_opts=None):
    """Mount remote directory via SSHFS if not already mounted, returning local mountpoint path.
    Applies Low-Resource Guard options to minimize remote CPU, memory, and disk I/O.
    """
    if not is_sshfs_installed():
        print(f"\n{RED}Erro:{RESET} O utilitário 'sshfs' não está instalado nesta máquina local.", file=sys.stderr)
        print("Para instalar o sshfs:")
        print("  • Debian/Ubuntu: sudo apt-get install sshfs")
        print("  • Fedora:        sudo dnf install fuse-sshfs")
        print("  • Arch Linux:    sudo pacman -S sshfs")
        print("  • macOS:         brew install macfuse gromgit/fuse/sshfs-mac\n", file=sys.stderr)
        sys.exit(1)

    target_remote_dir = remote_dir
    if not target_remote_dir or target_remote_dir == ".":
        res = ssh_run(host, "pwd", timeout=10)
        target_remote_dir = (res.stdout or "").strip() or "."

    if not local_name:
        clean_dir_name = os.path.basename(target_remote_dir.rstrip("/")) or "home"
        if clean_dir_name in (".", "~", ""):
            clean_dir_name = "home"
        local_name = clean_dir_name

    mountpoint = MOUNT_BASE / host / local_name
    mountpoint_str = str(mountpoint)

    active_mounts = get_active_sshfs_mounts()
    if any(mountpoint_str in line for line in active_mounts):
        return mountpoint_str

    mountpoint.mkdir(parents=True, exist_ok=True)

    # Low-Resource Guard options:
    # 1. compression=no: Prevents remote CPU spikes from gzip compression
    # 2. Ciphers: Hardware-accelerated lightweight ciphers (chacha20-poly1305, aes128-gcm)
    # 3. Aggressive metadata/directory cache on local client to avoid stat()/readdir() storms on remote server
    # 4. kernel_cache/auto_cache: Cache file pages locally in RAM
    # 5. no_rofd_flush: Avoid redundant write flushes for read descriptors
    default_opts = [
        "reconnect",
        "ServerAliveInterval=15",
        "ServerAliveCountMax=3",
        "follow_symlinks",
        "idmap=user",
        "compression=no",
        "Ciphers=chacha20-poly1305@openssh.com,aes128-gcm@openssh.com,aes256-gcm@openssh.com",
        "kernel_cache",
        "auto_cache",
        "dir_cache=yes",
        "dcache_timeout=120",
        "dcache_stat_timeout=120",
        "dcache_dir_timeout=120",
        "dcache_max_size=20000",
        "entry_timeout=120",
        "attr_timeout=120",
        "negative_timeout=30",
        "no_rofd_flush",
    ]

    cfg = load_host_config(host)
    if custom_opts:
        opts_list = custom_opts if isinstance(custom_opts, list) else [custom_opts]
    elif cfg.get("sshfs_opts"):
        opts_list = cfg.get("sshfs_opts").split(",")
    else:
        opts_list = default_opts

    opts_str = ",".join(opts_list)

    sshfs_cmd = [
        "sshfs",
        f"{host}:{target_remote_dir}",
        mountpoint_str,
        "-o", opts_str
    ]

    print(f"{BLUE}Mounting:{RESET} {host}:{target_remote_dir} -> {mountpoint_str}")
    print(f"🛡️  {CYAN}[Low-Resource Guard Ativo]{RESET} Cache local agressivo e zero daemons remotos (proteção de CPU/RAM/Disco no servidor).")
    res = subprocess.run(sshfs_cmd)
    if res.returncode == 0:
        mounts = load_mounts_state()
        mounts = [m for m in mounts if m.get("mountpoint") != mountpoint_str]
        mounts.append({
            "host": host,
            "remote_dir": target_remote_dir,
            "mountpoint": mountpoint_str,
            "mounted_at": time.time(),
            "low_resource_mode": True
        })
        save_mounts_state(mounts)
        print(f"{GREEN}Successfully mounted!{RESET}")
        return mountpoint_str
    else:
        print(f"{RED}Failed to mount {host}:{target_remote_dir} via SSHFS.{RESET}", file=sys.stderr)
        sys.exit(res.returncode or 1)


def connect_via_sshfs(host, remote_dir=None, args=None, cfg=None):
    """Mount remote directory via SSHFS and launch local OpenCode client."""
    if cfg is None:
        cfg = load_host_config(host)

    target_remote_dir = remote_dir or (args.dir if args and hasattr(args, "dir") else None) or cfg.get("remote_directory")
    mountpoint_str = mount_sshfs_target(host, target_remote_dir)

    print(f"\n{BOLD}{GREEN}Launching local OpenCode on SSHFS mount: {mountpoint_str}...{RESET}")
    print(f"{CYAN}ℹ  Host remoto '{host}' protegido: processamento e IA rodando 100% na máquina local.{RESET}\n")

    cmd = ["opencode", mountpoint_str]
    if args and getattr(args, "extra_args", None):
        cmd.extend(args.extra_args)

    exit_code = 0
    try:
        set_process_title(f"opencode: {host} (sshfs)")
        res = subprocess.run(cmd)
        exit_code = res.returncode
    except KeyboardInterrupt:
        print(f"\n{YELLOW}Session ended.{RESET}")
        exit_code = 0
    finally:
        set_process_title()

    unmount_exit = getattr(args, "unmount_on_exit", False)
    if unmount_exit:
        print(f"{BLUE}Unmounting SSHFS directory for '{host}'...{RESET}")
        subprocess.run(["fusermount", "-u", mountpoint_str], capture_output=True)
        mounts = [m for m in load_mounts_state() if m.get("mountpoint") != mountpoint_str]
        save_mounts_state(mounts)
        print(f"{GREEN}Unmounted.{RESET}")
    else:
        print(f"\n{BLUE}[ℹ] Diretório montado mantido ativo em:{RESET} {BOLD}{mountpoint_str}{RESET}")
        print(f"    Para desmontar quando desejar: {BOLD}opencode-remote unmount {host}{RESET} (ou {BOLD}ocd unmount {host}{RESET})\n")

    sys.exit(exit_code)


def handle_no_binary(host, remote_port, remote_dir, password, args, cfg):
    """Handle missing OpenCode binary on remote host with provision or SSHFS fallback."""
    if getattr(args, "provision", False):
        print(f"\n{BLUE}[ℹ] Provisionando OpenCode e sincronizando plugins no host remoto '{host}'...{RESET}")
        if provision_remote_host(host, sync_config=True):
            print(f"\n{BLUE}Reiniciando serviço 'opencode serve' após provisionamento...{RESET}")
            serve_args = argparse.Namespace(host=host, port=remote_port, password=password, restart=False, fatal=True)
            cmd_serve(serve_args)
            return
        else:
            print(f"{RED}Falha no provisionamento remoto do OpenCode.{RESET}", file=sys.stderr)
            sys.exit(1)

    if getattr(args, "no_sshfs_fallback", False):
        print(f"{RED}Erro:{RESET} OpenCode não está instalado em '{host}' e o fallback SSHFS está desativado (--no-sshfs-fallback).", file=sys.stderr)
        print(f"Para provisionar o OpenCode no host, execute: {BOLD}ocd connect {host} --provision{RESET}", file=sys.stderr)
        sys.exit(3)

    # Default fallback with Warning
    print(f"\n{YELLOW}⚠️  [Warning] OpenCode não está instalado no host remoto '{host}'.{RESET}")
    print(f"   {YELLOW}Ativando fallback automático via SSHFS (montagem local + OpenCode local).{RESET}")
    print(f"   {BLUE}(Para instalar o OpenCode e plugins no servidor remoto, execute: {BOLD}ocd connect {host} --provision{RESET}{BLUE}){RESET}\n")
    connect_via_sshfs(host, remote_dir=remote_dir, args=args, cfg=cfg)


def cmd_serve(args):
    host = args.host
    cfg = load_host_config(host)
    port = args.port if args.port is not None else cfg.get("remote_port", 4096)
    password = getattr(args, "password", None) or cfg.get("opencode_password")
    restart = getattr(args, "restart", False)
    fatal = getattr(args, "fatal", True)

    if restart:
        print(f"{BLUE}Restart: terminating any 'opencode serve' on port {port} at '{host}'...{RESET}")
        kill_remote_serve(host, port)

    print(f"{BLUE}Starting 'opencode serve --port {port}' on remote host '{host}'...{RESET}")

    env_prefix = ""
    if password:
        env_prefix = f'export OPENCODE_SERVER_PASSWORD="{password}"; export OPENCODE_PASSWORD="{password}"; '

    remote_cmd = (
        'OC_BIN="$(' + resolve_remote_opencode_bin() + ')"; '
        'if [ -z "$OC_BIN" ]; then echo "ERR:NO_BINARY"; exit 3; fi; '
        f'echo "BIN=$OC_BIN"; '
        f'if {remote_port_listening_cmd(port)}; then echo "RESULT:ALREADY_LISTENING"; exit 0; fi; '
        f'cd "$HOME" 2>/dev/null || true; '
        f'{env_prefix}nohup "$OC_BIN" serve --port {port} > "$HOME/.opencode-serve.log" 2>&1 & '
        'sleep 3; '
        f'if {remote_port_listening_cmd(port)}; then echo "RESULT:STARTED"; '
        f'else echo "RESULT:FAILED"; echo "--- log tail ---"; '
        'tail -n 15 "$HOME/.opencode-serve.log" 2>/dev/null; exit 4; fi'
    )
    try:
        res = ssh_run(host, remote_cmd, timeout=45)
    except subprocess.TimeoutExpired:
        print(f"{RED}Timeout starting 'opencode serve' on '{host}'.{RESET}", file=sys.stderr)
        if fatal:
            sys.exit(1)
        return False
    out = (res.stdout or "") + (res.stderr or "")
    print(out.strip())

    if "RESULT:STARTED" in out or "RESULT:ALREADY_LISTENING" in out:
        actual_pwd = password or get_remote_server_password(host, cfg)
        TUNNELS_DIR.mkdir(parents=True, exist_ok=True)
        tunnel_file = TUNNELS_DIR / f"{host}.json"
        data = {}
        if tunnel_file.exists():
            try:
                data = json.loads(tunnel_file.read_text())
            except Exception:
                pass
        data.update({
            "host": host,
            "remote_port": port,
            "password": actual_pwd,
            "remote_home": get_remote_default_dir(host)
        })
        tunnel_file.write_text(json.dumps(data, indent=2))

        print(f"{GREEN}OK: 'opencode serve' is listening on '{host}:{port}'.{RESET}")
        if actual_pwd:
            print(f"Server Password: {BOLD}{actual_pwd}{RESET}")
        print(f"Log file on remote host: ~/.opencode-serve.log")
        print(f"Next step: opencode-remote connect {host} (or opencode-remote tunnel {host} --port {port})")
        return True

    if "ERR:NO_BINARY" in out:
        if fatal:
            print(f"{RED}Failed to start 'opencode serve' on '{host}': OpenCode binary not found.{RESET}", file=sys.stderr)
            sys.exit(3)
        return "NO_BINARY"

    print(f"{RED}Failed to start 'opencode serve' on '{host}'.{RESET}", file=sys.stderr)
    if fatal:
        sys.exit(res.returncode or 1)
    return False


def cmd_tunnel(args):
    host = args.host
    cfg = load_host_config(host)
    remote_port = cfg.get("remote_port", 4096)
    if args.port is not None and not cfg.get("remote_port"):
        remote_port = args.port

    default_local_port = cfg.get("local_port", 4096)
    local_port, _ = resolve_local_port(host, requested_port=args.port, default_port=default_local_port, remote_port=remote_port)

    TUNNELS_DIR.mkdir(parents=True, exist_ok=True)
    tunnel_file = TUNNELS_DIR / f"{host}.json"

    # Check if tunnel already running
    if tunnel_file.exists():
        try:
            data = json.loads(tunnel_file.read_text())
            pid = data.get("pid")
            if pid and is_process_running(pid):
                active_port = data.get("local_port", data.get("port", local_port))
                ok, detail = probe_http(active_port)
                pwd = data.get("password") or get_remote_server_password(host, cfg)
                if ok:
                    print(f"{GREEN}Tunnel for '{host}' is already running.{RESET}")
                    print(f"PID: {pid} | Port: {active_port}")
                    print(f"{GREEN}E2E OK: {detail}{RESET}")
                    print(f"Local URL: {BOLD}http://localhost:{active_port}{RESET}")
                    if pwd:
                        print(f"Server Password: {BOLD}{pwd}{RESET}")
                        print(f"Web Login: User: {BOLD}opencode{RESET} | Password: {BOLD}{pwd}{RESET}")
                    print(f"Connect CLI: {BOLD}opencode-remote connect {host}{RESET}")
                    return True
                else:
                    print(f"{YELLOW}Cleaning up stale tunnel PID {pid}...{RESET}")
                    try:
                        os.kill(pid, 15)
                    except OSError:
                        pass
                    tunnel_file.unlink(missing_ok=True)
            else:
                tunnel_file.unlink(missing_ok=True)
        except Exception:
            pass

    print(f"{BLUE}Establishing SSH tunnel to '{host}' (localhost:{local_port} -> 127.0.0.1:{remote_port})...{RESET}")
    cmd = ["ssh"] + ssh_opts(host, ctl=False) + ["-N", "-f", "-L", f"{local_port}:127.0.0.1:{remote_port}", host]
    try:
        res = subprocess.run(cmd, env=ssh_env(_HOST_PASSWORDS.get(host)))
        tunnel_started = res.returncode == 0
    except Exception:
        tunnel_started = False
    if tunnel_started:
        pid = None
        ok = False
        detail = "Timeout"
        for _ in range(6):
            time.sleep(1)
            ok, detail = probe_http(local_port, timeout=3)
            if ok:
                pid = get_ssh_tunnel_pid(host, local_port)
                break

        pwd = get_remote_server_password(host, cfg)
        tunnel_data = {
            "host": host,
            "port": local_port,
            "local_port": local_port,
            "remote_port": remote_port,
            "pid": pid,
            "password": pwd,
            "remote_directory": cfg.get("remote_directory"),
            "started_at": time.time()
        }
        tunnel_file.write_text(json.dumps(tunnel_data, indent=2))

        if ok:
            print(f"{GREEN}SSH Tunnel active!{RESET}")
            print(f"Local port {local_port} forwarded to remote {host}:127.0.0.1:{remote_port}")
            print(f"{GREEN}E2E OK: {detail}{RESET}")
            print(f"Connect local OpenCode client to: {BOLD}http://localhost:{local_port}{RESET}")
            if pwd:
                print(f"Server Password: {BOLD}{pwd}{RESET}")
                print(f"Web Login: User: {BOLD}opencode{RESET} | Password: {BOLD}{pwd}{RESET}")
            print(f"Launch CLI: {BOLD}opencode-remote connect {host}{RESET}")
        else:
            print(f"{RED}E2E FAILED: {detail}{RESET}", file=sys.stderr)
            print(
                f"Tunnel is up locally, but nothing answers on remote port {remote_port}.\n"
                f"Start the remote daemon first: opencode-remote serve {host} --port {remote_port}",
                file=sys.stderr,
            )
            if getattr(args, "fatal", True):
                sys.exit(1)
            return False
        return True
    else:
        print(f"{RED}Failed to set up SSH tunnel to '{host}'.{RESET}", file=sys.stderr)
        if getattr(args, "fatal", True):
            sys.exit(1)
        return False


def cmd_connect(args):
    host = args.host
    set_process_title(f"opencode: {host}")
    cfg = load_host_config(host)
    remote_port = cfg.get("remote_port", 4096)
    if args.port is not None and not cfg.get("remote_port"):
        remote_port = args.port

    default_local_port = cfg.get("local_port", 4096)
    local_port, _ = resolve_local_port(host, requested_port=args.port, default_port=default_local_port, remote_port=remote_port)
    remote_dir = args.dir or cfg.get("remote_directory") or get_remote_default_dir(host)
    password = getattr(args, "password", None) or cfg.get("opencode_password")

    # If --sshfs or --mount was passed explicitly, branch immediately to SSHFS mode
    sshfs_arg = getattr(args, "sshfs", None)
    if sshfs_arg is not None:
        target_dir = sshfs_arg if (isinstance(sshfs_arg, str) and sshfs_arg != ".") else remote_dir
        print(f"{BOLD}=== Connecting to Remote OpenCode (SSHFS Mode): {host} ==={RESET}\n")
        connect_via_sshfs(host, remote_dir=target_dir, args=args, cfg=cfg)
        return

    print(f"{BOLD}=== Connecting to Remote OpenCode: {host} ==={RESET}\n")

    # 1. SSH check (asks for password interactively if the host has no key)
    print(f"[1/4] Checking SSH connection to '{host}'...", end="", flush=True)
    ssh_ok, reason = check_ssh_host_detailed(host, interactive=True)
    if not ssh_ok:
        print(f" {RED}FAILED ({reason}){RESET}")
        if reason == "KEY_NEEDED":
            print(f"\n{YELLOW}Chave SSH não aceita pelo host '{host}' (autenticação por chave necessária).{RESET}")
            print(f"Para autorizar sua máquina com 1 comando, execute:")
            print(f"  {BOLD}ssh-copy-id {host}{RESET} (ou: {BOLD}opencode-remote copy-key {host}{RESET})\n", file=sys.stderr)
        else:
            print(f"\n{RED}Erro:{RESET} Host '{host}' está inacessível via SSH ({reason}).\n", file=sys.stderr)
        sys.exit(1)
    print(f" {GREEN}ONLINE{RESET}")

    # 2. Remote serve daemon — real HTTP health probe + auto-repair
    print(f"[2/4] Verifying remote 'opencode serve' (port {remote_port})...", end="", flush=True)
    healthy = remote_service_healthy(host, remote_port)
    if healthy is True:
        print(f" {GREEN}RUNNING (HTTP OK){RESET}")
    elif healthy is False:
        # Port accepts TCP but does not answer (hung daemon) -> recycle it.
        listening = subprocess.run(
            ["ssh"] + ssh_opts(host) + [host, remote_port_listening_cmd(remote_port)],
            capture_output=True,
        ).returncode == 0
        if listening:
            print(f" {YELLOW}HUNG (accepts TCP, no HTTP) - restarting daemon...{RESET}")
            kill_remote_serve(host, remote_port)
        else:
            print(f" {YELLOW}NOT RUNNING - starting now...{RESET}")
        serve_args = argparse.Namespace(host=host, port=remote_port, password=password, restart=False, fatal=False)
        serve_res = cmd_serve(serve_args)
        if serve_res == "NO_BINARY":
            handle_no_binary(host, remote_port, remote_dir, password, args, cfg)
        elif remote_service_healthy(host, remote_port) is not True:
            print(f"{RED}Remote daemon did not become healthy after restart.{RESET}", file=sys.stderr)
            sys.exit(1)
    else:
        # Health probe inconclusive (no curl/python3 remotely): fallback to ss check.
        check_cmd = remote_port_listening_cmd(remote_port)
        res = ssh_run(host, check_cmd, timeout=15, interactive=False)
        if res.returncode != 0:
            print(f" {YELLOW}NOT RUNNING - starting now...{RESET}")
            serve_args = argparse.Namespace(host=host, port=remote_port, password=password, restart=False, fatal=False)
            serve_res = cmd_serve(serve_args)
            if serve_res == "NO_BINARY":
                handle_no_binary(host, remote_port, remote_dir, password, args, cfg)
        else:
            print(f" {GREEN}RUNNING{RESET}")

    # 3. Local SSH tunnel (non-fatal: we repair and retry below)
    print(f"[3/4] Verifying local SSH tunnel (localhost:{local_port} -> {host}:{remote_port})...", end="", flush=True)
    ok, detail = probe_http(local_port)
    if ok:
        print(f" {GREEN}ACTIVE ({detail}){RESET}")
    else:
        print(f" {YELLOW}INACTIVE - establishing tunnel...{RESET}")
        tunnel_args = argparse.Namespace(host=host, port=local_port, fatal=False)
        cmd_tunnel(tunnel_args)
        ok, detail = probe_http(local_port)
        if not ok:
            # Tunnel up but no answer: remote daemon hung mid-flight -> repair once.
            print(f" {YELLOW}No HTTP answer - recycling remote daemon and retrying...{RESET}")
            kill_remote_serve(host, remote_port)
            serve_args = argparse.Namespace(host=host, port=remote_port, password=password, restart=False, fatal=False)
            serve_res = cmd_serve(serve_args)
            if serve_res == "NO_BINARY":
                handle_no_binary(host, remote_port, remote_dir, password, args, cfg)
            for _ in range(6):
                time.sleep(1)
                ok, detail = probe_http(local_port, timeout=3)
                if ok:
                    break
            if not ok:
                print(f"{RED}E2E FAILED: tunnel is up but remote port {remote_port} never answered.{RESET}", file=sys.stderr)
                sys.exit(1)
            print(f" {GREEN}RECOVERED ({detail}){RESET}")
        else:
            print(f" {GREEN}ACTIVE ({detail}){RESET}")

    # 4. Resolve password
    pwd = password or get_remote_server_password(host, cfg)
    status_auth = f"{GREEN}DETECTED{RESET}" if pwd else f"{YELLOW}NONE / OPEN{RESET}"
    print(f"[4/4] Authentication token: {status_auth}")

    # 5. Launch OpenCode client
    server_url = f"http://localhost:{local_port}"
    print(f"\n{BOLD}{GREEN}Launching OpenCode client connected to {server_url}...{RESET}")
    if remote_dir:
        print(f"Remote working directory: {BLUE}{remote_dir}{RESET}")
    if pwd:
        print(f"Web Login (Browser): User: {BOLD}opencode{RESET} | Password: {BOLD}{pwd}{RESET}")
    print()

    env = os.environ.copy()
    if pwd:
        env["OPENCODE_PASSWORD"] = pwd
        env["OPENCODE_SERVER_PASSWORD"] = pwd
    env["OPENCODE_SERVER_URL"] = server_url
    env["OPENCODE_REMOTE_HOST"] = host
    env["OPENCODE_REMOTE_PORT"] = str(local_port)

    cmd = ["opencode", "--server", server_url]
    if remote_dir:
        cmd.append(remote_dir)
    if getattr(args, "extra_args", None):
        cmd.extend(args.extra_args)

    exit_code = 0
    try:
        set_process_title(f"opencode: {host}")
        res = subprocess.run(cmd, env=env)
        exit_code = res.returncode
    except KeyboardInterrupt:
        print(f"\n{YELLOW}Session ended.{RESET}")
        exit_code = 0
    finally:
        set_process_title()

    close_tunnel = getattr(args, "close_tunnel", False) or cfg.get("close_tunnel_on_exit", True)
    if getattr(args, "keep_tunnel", False):
        close_tunnel = False
    if close_tunnel:
        print(f"{BLUE}Closing SSH tunnel for '{host}' (port {local_port})...{RESET}")
        stop_tunnel_only(host, local_port)
        close_ssh_master(host)
        print(f"{GREEN}Tunnel closed.{RESET}")
    else:
        print(f"\n{BLUE}[ℹ] SSH tunnel for '{host}' (localhost:{local_port}) remains active in background.{RESET}")
        print(f"    To stop: {BOLD}opencode-remote stop {host}{RESET} (or {BOLD}ocd stop {host}{RESET})")
        print(f"    To keep it open on exit: {BOLD}opencode-remote connect {host} --keep-tunnel{RESET}\n")

    sys.exit(exit_code)


def collect_all_hosts():
    """Union of hosts from ~/.ssh/config and ~/.config/opencode/remote/*.env."""
    hosts = [h["host"] for h in parse_ssh_config()]
    try:
        if CONFIG_DIR.exists():
            for f in CONFIG_DIR.glob("*.env"):
                if f.stem and f.stem != "example" and f.stem not in hosts:
                    hosts.append(f.stem)
    except Exception:
        pass
    return hosts


def _status_one(host, port=None, timeout=4):
    cfg = load_host_config(host)
    
    tunnel_file = TUNNELS_DIR / f"{host}.json"
    saved_local_port = None
    saved_remote_port = None
    if tunnel_file.exists():
        try:
            data = json.loads(tunnel_file.read_text())
            saved_local_port = data.get("local_port", data.get("port"))
            saved_remote_port = data.get("remote_port")
        except Exception:
            pass

    local_port = port if port is not None else (saved_local_port or cfg.get("local_port", 4096))
    remote_port = saved_remote_port or cfg.get("remote_port", local_port)

    row = {"host": host, "local_port": local_port, "remote_port": remote_port}

    # 1. SSH
    ssh_ok, reason = check_ssh_host_detailed(host, timeout=timeout, interactive=False)
    row["ssh"] = "ONLINE" if ssh_ok else reason
    row["ssh_ok"] = ssh_ok

    # 2. Remote serve (HTTP health when SSH is up)
    if ssh_ok:
        healthy = remote_service_healthy(host, remote_port)
        if healthy is True:
            row["serve"] = "RUNNING"
        elif healthy is False:
            listening = subprocess.run(
                ["ssh"] + ssh_opts(host) + [host, remote_port_listening_cmd(remote_port)],
                capture_output=True, timeout=timeout + 8,
            ).returncode == 0
            row["serve"] = "HUNG" if listening else "STOPPED"
        else:
            row["serve"] = "UNKNOWN"
    else:
        row["serve"] = "?"

    # 3. Local tunnel
    ok, detail = probe_http(local_port, timeout=3)
    if ok:
        row["tunnel"] = f"ACTIVE (:{local_port})" if local_port != 4096 else f"ACTIVE ({detail})"
    else:
        pid = get_ssh_tunnel_pid(host, local_port)
        row["tunnel"] = f"STALE (pid {pid})" if pid else "INACTIVE"

    # 4. Password
    pwd = get_remote_server_password(host, cfg) if ssh_ok else cfg.get("opencode_password")
    row["password"] = pwd
    return row


def cmd_status_all(args):
    hosts = collect_all_hosts()
    if not hosts:
        print("No hosts found (~/.ssh/config or ~/.config/opencode/remote/*.env).")
        return

    print(f"{BOLD}=== Status: {len(hosts)} host(s) ==={RESET}\n")
    timeout = getattr(args, "timeout", 4)

    rows = []
    with ThreadPoolExecutor(max_workers=min(8, len(hosts))) as ex:
        futs = {ex.submit(_status_one, h, args.port, timeout): h for h in hosts}
        for fut in as_completed(futs):
            try:
                rows.append(fut.result())
            except Exception as e:
                rows.append({"host": futs[fut], "ssh": f"ERR:{type(e).__name__}",
                             "serve": "?", "tunnel": "?", "password": None,
                             "ssh_ok": False})

    order = {h: i for i, h in enumerate(hosts)}
    rows.sort(key=lambda r: order.get(r["host"], 999))

    fmt = "{:<20} {:<14} {:<12} {:<22} {:<16}"
    print(BOLD + fmt.format("HOST", "SSH", "SERVE", "TUNNEL (local)", "SERVER PASSWORD") + RESET)
    print("-" * 86)
    for r in rows:
        ssh_s = f"{GREEN}ONLINE{RESET}" if r.get("ssh_ok") else f"{YELLOW}{r.get('ssh', '?')}{RESET}"
        serve = r.get("serve", "?")
        if serve == "RUNNING":
            serve_s = f"{GREEN}RUNNING{RESET}"
        elif serve == "HUNG":
            serve_s = f"{RED}HUNG{RESET}"
        elif serve == "STOPPED":
            serve_s = f"{YELLOW}STOPPED{RESET}"
        else:
            serve_s = f"{YELLOW}{serve}{RESET}"
        tun = r.get("tunnel", "?")
        tun_s = f"{GREEN}{tun}{RESET}" if tun.startswith("ACTIVE") else f"{YELLOW}{tun}{RESET}"
        pwd = r.get("password")
        pwd_s = f"{GREEN}{pwd}{RESET}" if pwd else f"{YELLOW}—{RESET}"
        print(fmt.format(r["host"][:19], ssh_s, serve_s, tun_s[:21], pwd_s[:15]))
    print()
    print(f"{BOLD}Details:{RESET} opencode-remote status <host> | {BOLD}Connect:{RESET} opencode-remote connect <host>")
    print()


def cmd_status(args):
    if not args.host:
        return cmd_status_all(args)

    host = args.host
    cfg = load_host_config(host)
    
    tunnel_file = TUNNELS_DIR / f"{host}.json"
    saved_local_port = None
    saved_remote_port = None
    if tunnel_file.exists():
        try:
            data = json.loads(tunnel_file.read_text())
            saved_local_port = data.get("local_port", data.get("port"))
            saved_remote_port = data.get("remote_port")
        except Exception:
            pass

    local_port = args.port if args.port is not None else (saved_local_port or cfg.get("local_port", 4096))
    remote_port = saved_remote_port or cfg.get("remote_port", local_port)

    print(f"{BOLD}=== Status for Remote Host: {host} ==={RESET}\n")

    # 1. SSH Connectivity
    print(f"[1/4] SSH Connectivity: ", end="", flush=True)
    ssh_ok, ssh_reason = check_ssh_host_detailed(host, interactive=True)
    if ssh_ok:
        print(f"{GREEN}ONLINE{RESET}")
    else:
        print(f"{RED}OFFLINE / UNREACHABLE ({ssh_reason}){RESET}")

    # 2. Remote opencode serve
    print(f"[2/4] Remote 'opencode serve' (port {remote_port}): ", end="", flush=True)
    if ssh_ok:
        healthy = remote_service_healthy(host, remote_port)
        if healthy is True:
            print(f"{GREEN}RUNNING (HTTP OK){RESET}")
        elif healthy is False:
            listening = subprocess.run(
                ["ssh"] + ssh_opts(host) + [host, remote_port_listening_cmd(remote_port)],
                capture_output=True, timeout=20,
            ).returncode == 0
            if listening:
                print(f"{RED}HUNG{RESET}  (port open but no HTTP answer)")
                print(f"      fix: opencode-remote serve {host} --port {remote_port} --restart")
            else:
                print(f"{YELLOW}STOPPED{RESET}  (nothing listening on remote port {remote_port})")
                print(f"      fix: opencode-remote serve {host} --port {remote_port}")
        else:
            print(f"{YELLOW}UNKNOWN{RESET}  (remote probe inconclusive)")
    else:
        print(f"{YELLOW}UNKNOWN (SSH down){RESET}")

    # 3. Local SSH Tunnel
    print(f"[3/4] Local SSH Tunnel (localhost:{local_port} -> {host}:{remote_port}): ", end="", flush=True)
    ok, detail = probe_http(local_port)
    if ok:
        print(f"{GREEN}ACTIVE{RESET} ({detail})")
    else:
        pid = get_ssh_tunnel_pid(host, local_port)
        if pid:
            print(f"{YELLOW}INACTIVE{RESET} (Stale PID {pid})")
            print(f"      fix: opencode-remote stop {host} --port {local_port} && opencode-remote tunnel {host} --port {local_port}")
        else:
            print(f"{YELLOW}INACTIVE{RESET}")
            print(f"      fix: opencode-remote tunnel {host} --port {local_port}")

    # 4. Authentication & Quick Connect
    pwd = get_remote_server_password(host, cfg)
    print(f"[4/4] Server Auth / Password: ", end="", flush=True)
    if pwd:
        print(f"{GREEN}DETECTED{RESET} (Password: {pwd})")
    else:
        print(f"{YELLOW}NOT CONFIGURED{RESET}")

    print(f"\n{BOLD}Quick Connect:{RESET} {GREEN}opencode-remote connect {host}{RESET}")
    print()


def cmd_stop(args):
    host = args.host
    cfg = load_host_config(host)
    
    tunnel_file = TUNNELS_DIR / f"{host}.json"
    saved_local_port = None
    saved_remote_port = None
    if tunnel_file.exists():
        try:
            data = json.loads(tunnel_file.read_text())
            saved_local_port = data.get("local_port", data.get("port"))
            saved_remote_port = data.get("remote_port")
        except Exception:
            pass

    local_port = args.port if args.port is not None else (saved_local_port or cfg.get("local_port", 4096))
    remote_port = saved_remote_port or cfg.get("remote_port", local_port)

    print(f"{BLUE}Stopping remote services and local tunnels for host '{host}'...{RESET}")

    # Stop local tunnel
    stop_tunnel_only(host, local_port)

    # Stop remote daemon
    print(f"Stopping remote 'opencode serve' on port {remote_port} at '{host}'...")
    stop_cmd = (
        f"PID=$(ss -tlnpH 2>/dev/null | grep -E ':{remote_port}[[:space:]]' "
        f"| grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2); "
        f'if [ -n "$PID" ]; then kill "$PID" && echo "Stopped remote serve PID $PID"; '
        f'else echo "No process listening on remote port {remote_port}"; fi'
    )
    subprocess.run(["ssh"] + ssh_opts(host) + [host, stop_cmd])
    close_ssh_master(host)
    print(f"{GREEN}Cleanup complete for '{host}'.{RESET}")


def cmd_mount(args):
    mountpoint_str = mount_sshfs_target(args.host, args.remote_dir, local_name=args.local_name)
    print(f"{GREEN}Path:{RESET} {mountpoint_str}")


def cmd_unmount(args):
    target = args.host_or_path
    mounts = load_mounts_state()

    target_mountpoint = None
    for m in mounts:
        if m.get("host") == target or m.get("mountpoint") == target or m.get("remote_dir") == target:
            target_mountpoint = m.get("mountpoint")
            break

    if not target_mountpoint:
        possible_path = Path(target).expanduser().resolve()
        target_mountpoint = str(possible_path)

    print(f"{BLUE}Unmounting:{RESET} {target_mountpoint}")

    res = subprocess.run(["fusermount", "-u", target_mountpoint], capture_output=True, text=True)
    if res.returncode != 0:
        res = subprocess.run(["umount", target_mountpoint], capture_output=True, text=True)

    mounts = [m for m in mounts if m.get("mountpoint") != target_mountpoint]
    save_mounts_state(mounts)

    try:
        mp = Path(target_mountpoint)
        if mp.exists() and mp.is_dir() and not any(mp.iterdir()):
            mp.rmdir()
            if mp.parent.exists() and mp.parent.is_dir() and not any(mp.parent.iterdir()):
                mp.parent.rmdir()
    except Exception:
        pass

    if res.returncode == 0:
        print(f"{GREEN}Successfully unmounted {target_mountpoint}.{RESET}")
    else:
        print(f"{YELLOW}Unmount completed or reported warning for {target_mountpoint}.{RESET}")


def cmd_mounts(args):
    mounts = load_mounts_state()
    active_system_mounts = get_active_sshfs_mounts()

    if not mounts and not active_system_mounts:
        print("No SSHFS mounts active.")
        return

    print(f"{BOLD}=== Active SSHFS Mounts ==={RESET}\n")
    fmt = "{:<16} {:<30} {:<35} {:<10}"
    print(BOLD + fmt.format("HOST", "REMOTE DIR", "LOCAL MOUNTPOINT", "STATUS") + RESET)
    print("-" * 95)

    seen_mountpoints = set()
    for m in mounts:
        mp = m.get("mountpoint", "")
        seen_mountpoints.add(mp)
        is_active = any(mp in line for line in active_system_mounts)
        status_str = f"{GREEN}MOUNTED{RESET}" if is_active else f"{RED}STALE/UNMOUNTED{RESET}"
        print(fmt.format(
            m.get("host", "-")[:15],
            m.get("remote_dir", "-")[:29],
            mp[:34],
            status_str
        ))

    for line in active_system_mounts:
        parts = line.split()
        if len(parts) >= 3:
            src, _, mp = parts[0], parts[1], parts[2]
            if mp not in seen_mountpoints and (str(MOUNT_BASE) in mp or str(LEGACY_MOUNT_BASE) in mp):
                host = src.split(":")[0] if ":" in src else "-"
                rdir = src.split(":")[1] if ":" in src else "-"
                print(fmt.format(host[:15], rdir[:29], mp[:34], f"{GREEN}MOUNTED{RESET}"))
    print()


def cmd_copy_key(args):
    host = args.host
    print(f"{BLUE}Configurando chave SSH pública no host '{host}' via ssh-copy-id...{RESET}")
    cmd = ["ssh-copy-id"]
    if getattr(args, "identity_file", None):
        cmd.extend(["-i", args.identity_file])
    cmd.append(host)
    res = subprocess.run(cmd)
    if res.returncode == 0:
        print(f"\n{GREEN}Chave SSH instalada com sucesso em '{host}'!{RESET}")
        print(f"Agora você pode conectar sem senha com: {BOLD}opencode-remote connect {host}{RESET} (ou: {BOLD}ocd connect {host}{RESET})")
    else:
        print(f"\n{RED}Falha ao instalar chave SSH no host '{host}'.{RESET}", file=sys.stderr)
    sys.exit(res.returncode)


def main():
    set_process_title()
    parser = argparse.ArgumentParser(
        prog="opencode-remote",
        description="OpenCode Remote Host Automation & Control CLI"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # list
    p_list = subparsers.add_parser("list", help="List SSH hosts and check connectivity")
    p_list.add_argument("--json", action="store_true", help="Output JSON format")
    p_list.add_argument("--timeout", type=int, default=3, help="SSH connection timeout in seconds")
    p_list.set_defaults(func=cmd_list)

    # copy-key
    p_key = subparsers.add_parser("copy-key", help="Copy SSH public key to remote host for passwordless login (ssh-copy-id)")
    p_key.add_argument("host", help="Remote SSH host name")
    p_key.add_argument("-i", "--identity", dest="identity_file", default=None, help="Identity file (e.g. ~/.ssh/id_ed25519.pub)")
    p_key.set_defaults(func=cmd_copy_key)

    # exec
    p_exec = subparsers.add_parser("exec", help="Execute command on remote host")
    p_exec.add_argument("host", help="Remote SSH host name")
    p_exec.add_argument("cmd", nargs=argparse.REMAINDER, help="Command to execute")
    p_exec.set_defaults(func=cmd_exec)

    # sync
    p_sync = subparsers.add_parser("sync", help="Sync local directory to remote host via rsync")
    p_sync.add_argument("host", help="Remote SSH host name")
    p_sync.add_argument("local_dir", help="Local directory path")
    p_sync.add_argument("remote_dir", help="Remote target directory path")
    p_sync.add_argument("--delete", action="store_true", help="Delete extraneous files from dest dirs")
    p_sync.add_argument("--dry-run", action="store_true", help="Perform a trial run with no changes made")
    p_sync.set_defaults(func=cmd_sync)

    # provision
    p_prov = subparsers.add_parser("provision", help="Install OpenCode headless and sync plugins on remote host")
    p_prov.add_argument("host", help="Remote SSH host name")
    p_prov.add_argument("--no-sync", action="store_true", help="Do not sync local plugins and configuration to remote host")
    p_prov.set_defaults(func=cmd_provision)

    # serve
    p_serve = subparsers.add_parser("serve", help="Start opencode serve on remote host")
    p_serve.add_argument("host", help="Remote SSH host name")
    p_serve.add_argument("--port", type=int, default=None, help="Port for opencode serve (default: from .env or 4096)")
    p_serve.add_argument("--password", default=None, help="Password for remote opencode serve")
    p_serve.add_argument("--restart", action="store_true", help="Kill any existing 'opencode serve' on the port first")
    p_serve.set_defaults(func=cmd_serve)

    # tunnel
    p_tun = subparsers.add_parser("tunnel", help="Set up SSH local port forwarding")
    p_tun.add_argument("host", help="Remote SSH host name")
    p_tun.add_argument("--port", type=int, default=None, help="Local/Remote port (default: from .env or 4096)")
    p_tun.set_defaults(func=cmd_tunnel)

    # connect (Unified one-command launcher)
    p_conn = subparsers.add_parser("connect", help="One-command connect: starts serve, sets up tunnel, and launches OpenCode client")
    p_conn.add_argument("host", help="Remote SSH host name")
    p_conn.add_argument("--port", type=int, default=None, help="Local/Remote port (default: from .env or 4096)")
    p_conn.add_argument("--dir", dest="dir", default=None, help="Remote directory to open (default: from .env)")
    p_conn.add_argument("--sshfs", "--mount", dest="sshfs", nargs="?", const=".", default=None, help="Connect via SSHFS mount instead of remote daemon (optional: remote directory)")
    p_conn.add_argument("--provision", action="store_true", help="Auto-install OpenCode headless and sync plugins if not present on remote host")
    p_conn.add_argument("--no-sshfs-fallback", action="store_true", help="Disable automatic SSHFS fallback if remote OpenCode binary is missing")
    p_conn.add_argument("--unmount-on-exit", action="store_true", help="Unmount SSHFS directory when session ends")
    p_conn.add_argument("--password", default=None, help="Server password (default: from .env or auto-detected)")
    p_conn.add_argument("--close-tunnel", action="store_true", help="Close SSH tunnel when session ends (default behavior)")
    p_conn.add_argument("--keep-tunnel", action="store_true", help="Keep the SSH tunnel open in background after exit")
    p_conn.add_argument("extra_args", nargs=argparse.REMAINDER, help="Extra arguments passed to opencode CLI")
    p_conn.set_defaults(func=cmd_connect)

    # status (optional host: omit to check every known host)
    p_stat = subparsers.add_parser("status", help="Check host connection, remote serve, and local tunnel (all hosts when omitted)")
    p_stat.add_argument("host", nargs="?", default=None, help="Remote SSH host name (omit for all hosts)")
    p_stat.add_argument("--port", type=int, default=None, help="Port to check (default: from .env or 4096)")
    p_stat.add_argument("--timeout", type=int, default=4, help="Per-host SSH timeout in seconds (all-hosts mode)")
    p_stat.set_defaults(func=cmd_status)

    # stop
    p_stop = subparsers.add_parser("stop", help="Stop local tunnel and remote serve process")
    p_stop.add_argument("host", help="Remote SSH host name")
    p_stop.add_argument("--port", type=int, default=None, help="Port (default: from .env or 4096)")
    p_stop.set_defaults(func=cmd_stop)

    # mount
    p_mnt = subparsers.add_parser("mount", help="Mount a remote directory locally via SSHFS")
    p_mnt.add_argument("host", help="Remote SSH host name")
    p_mnt.add_argument("remote_dir", help="Remote directory path")
    p_mnt.add_argument("--as", dest="local_name", help="Local directory name for mountpoint")
    p_mnt.set_defaults(func=cmd_mount)

    # unmount
    p_unmnt = subparsers.add_parser("unmount", help="Unmount SSHFS directory")
    p_unmnt.add_argument("host_or_path", help="Host name, remote dir, or local mount path")
    p_unmnt.set_defaults(func=cmd_unmount)

    # mounts
    p_mnts = subparsers.add_parser("mounts", help="List active SSHFS mounts")
    p_mnts.set_defaults(func=cmd_mounts)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()

